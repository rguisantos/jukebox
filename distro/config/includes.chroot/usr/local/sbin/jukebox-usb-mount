#!/bin/sh
set -eu
case "$1" in *[!a-zA-Z0-9_-]*|'') exit 1;; esac
# Never re-import the live system or persistent data partition.
label=$(blkid -s LABEL -o value "/dev/$1" || true)
[ "$label" != JUKEBOX_DATA ] || exit 0
mountpoint -q "/media/usb/$1" && exit 0
mkdir -p "/media/usb/$1"
mount -o ro,nosuid,nodev,noexec "/dev/$1" "/media/usb/$1"
