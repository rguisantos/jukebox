#!/usr/bin/env bash
# ==============================================================================
# Jukebox OS - Utilitário de Manutenção
# Permite realizar alterações persistentes no sistema com OverlayFS ativo
# ==============================================================================
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "Execute como root (sudo jukebox-maintenance)"
    exit 1
fi

echo "=========================================================="
echo " JUKEBOX OS - MODO DE MANUTENÇÃO (R/W DIRETO NO DISCO)   "
echo "=========================================================="
echo "Você está entrando em um chroot na partição física real."
echo "Qualquer pacote instalado ou configuração alterada aqui"
echo "será gravada permanentemente no disco."
echo ""
echo "Para sair e retornar ao modo blindado, digite 'exit'."
echo "=========================================================="

overlayroot-chroot
