# ==============================================================================
# JUKEBOX OS — MÓDULO 6: Autostart da sessão Openbox (kiosk)
# ------------------------------------------------------------------------------
# Executado pelo openbox-session quando a sessão X sobe. Desliga qualquer
# economia de energia do monitor (máquina de bar fica ligada o dia inteiro)
# e sobe o watchdog que mantém o Jukebox sempre na tela.
# ==============================================================================

# Desativa descanso de tela, DPMS (economia de energia) e tela preta
xset s off
xset -dpms
xset s noblank

# Inicia o Watchdog do Jukebox em background
/home/jukebox/launcher.sh &
