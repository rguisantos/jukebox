# ==============================================================================
# JUKEBOX OS — Automontagem de pendrive (Módulo 4: USB Sync)
# ------------------------------------------------------------------------------
# Monta a primeira partição com sistema de arquivos de QUALQUER pendrive USB
# em /media/usb em modo SOMENTE LEITURA, no instante da inserção.
#
# Por que read-only?
#   1. O pendrive do operador nunca é gravado (zero risco de corrupção
#      quando ele arranca o dispositivo no meio da cópia);
#   2. Montagem instantânea e à prova de sujeira no FS (ext4 dirty, etc.);
#   3. Sem mensagens de recuperação de journal travando o boot da mídia.
#
# A desmontagem acontece no evento "remove": o script de montagem registra
# o devnode em /run/jukebox-usb.dev e o udev chama o mesmo script para
# desmontar quando o dispositivo some.
# ==============================================================================

# Ignora o disco do sistema (o jukebox roda de overlayroot, mas por segurança)
SUBSYSTEM=="block", ENV{ID_BUS}!="usb", GOTO="jukebox_usb_end"

# Apenas partições com sistema de arquivos identificado
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_FS_USAGE}=="filesystem", RUN+="/usr/local/sbin/jukebox-usb-mount.sh add $devnode"

# Desmontagem imediata na remoção física (mesmo pendrive ou disco inteiro)
ACTION=="remove", SUBSYSTEM=="block", RUN+="/usr/local/sbin/jukebox-usb-mount.sh remove $devnode"

LABEL="jukebox_usb_end"
