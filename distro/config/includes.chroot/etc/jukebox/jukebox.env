# ==============================================================================
# JUKEBOX OS — Configuração local da máquina (Módulo 6)
# ------------------------------------------------------------------------------
# Este é um TEMPLATE somente-leitura que faz parte do sistema. Na primeira
# inicialização o launcher.sh o copia para /dados/jukebox.env (partição
# gravável). Configure cada máquina editando esse arquivo:
#
#     sudo nano /dados/jukebox.env      (e reinicie a máquina)
#
# Com o overlayroot ativo, o / é congelado — este arquivo é o único ponto
# de configuração que sobrevive entre reinicializações.
# ==============================================================================

# Backend na nuvem que gera o QR Code PIX dinâmico e responde o polling.
# Aceita tanto a origem (https://seu-backend.com) quanto o caminho completo
# (https://seu-backend.com/api/pix).
JUKEBOX_PIX_API=https://meu-backend.com/api/pix

# Identificador único desta máquina no backend (troque por máquina!)
JUKEBOX_MACHINE_ID=JBOX-001

# 1 = modo demo: gera QR simulado e confirma o pagamento sozinho, SEM
# falar com o backend. Use para testar a máquina no balcão antes de
# plugar a API de verdade. 0 = produção.
JUKEBOX_PIX_DEMO=0

# Nível de log do aplicativo (error | warn | info | debug)
RUST_LOG=info
