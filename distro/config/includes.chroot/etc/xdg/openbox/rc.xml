<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==============================================================================
  JUKEBOX OS — Openbox enxuto para kiosk
  ------------------------------------------------------------------------------
  Única função do WM: deixar a janela do jukebox-app em tela cheia REAL, sem
  barra de título, sem borda e sem possibilidade de mover/redimensionar.
  Sem menus, sem atalhos de janela (o app controla tudo via teclado).
  ==============================================================================
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">

  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>

  <placement>
    <policy>Smart</policy>
  </placement>

  <theme>
    <name>Clearlooks</name>
  </theme>

  <!-- Sem ações de mouse/janela que fujam do kiosk -->
  <mouse>
    <dragThreshold>8</dragThreshold>
  </mouse>

  <keyboard>
    <!-- Nenhum atalho global: todas as teclas pertencem ao jukebox-app -->
  </keyboard>

  <!--
    Regra central do kiosk: QUALQUER janela (o jukebox, ou um eventual
    xmessage de erro) abre maximizada, sem decoração e sem poder ser
    fechada/movida por acidente.
  -->
  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
  </applications>

</openbox_config>
