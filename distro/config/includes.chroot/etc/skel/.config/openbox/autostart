# ==============================================================================
# JUKEBOX OS — MÓDULO 6: autostart da sessão Openbox (kiosk)
# ------------------------------------------------------------------------------
# Executado pelo openbox-session quando a sessão X sobe. Desliga qualquer
# economia de energia do monitor (a máquina do bar fica ligada o dia inteiro)
# e sobe o watchdog que mantém o Jukebox sempre na tela.
# ==============================================================================

# Sem protetor de tela, sem apagamento, sem DPMS — a tela nunca escurece
xset s off
xset s noblank
xset -dpms

# Watchdog do aplicativo (loop infinito — reinicia o jukebox-app se ele cair)
/opt/jukebox/launcher.sh &
