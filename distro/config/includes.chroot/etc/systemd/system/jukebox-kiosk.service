[Unit]
Description=Jukebox graphical session
Requires=jukebox-data.service
After=jukebox-data.service systemd-user-sessions.service
StartLimitIntervalSec=0

[Service]
User=jukebox
PAMName=login
Environment=XDG_SESSION_TYPE=x11
WorkingDirectory=/home/jukebox
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
ExecStart=/usr/bin/startx -- :0 vt1 -keeptty -nocursor -nolisten tcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
