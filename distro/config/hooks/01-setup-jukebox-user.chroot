#!/bin/sh
set -e

echo "--> [Hook Jukebox] Configurando usuário jukebox e permissões de hardware..."

# Criação do usuário jukebox se não existir
if ! id -u jukebox >/dev/null 2>&1; then
    useradd -m -s /bin/bash -u 1000 -c "Jukebox Arcade Operator" jukebox
    echo "jukebox:jukebox" | chpasswd
fi

# Grupos de hardware essenciais
usermod -aG audio,video,input,render,sudo jukebox

# Sudo sem senha para o usuário jukebox (manutenção rápida em campo)
mkdir -p /etc/sudoers.d
echo "jukebox ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/jukebox
chmod 0440 /etc/sudoers.d/jukebox

# Criação e permissões do diretório persistente /dados
mkdir -p /dados
chown -R jukebox:jukebox /dados
chmod 775 /dados

# Permissões dos scripts executáveis
chmod +x /usr/local/bin/jukebox-install-to-disk.sh || true
chmod +x /usr/local/bin/jukebox-maintenance || true
chmod +x /home/jukebox/.xinitrc || true
chown -R jukebox:jukebox /home/jukebox

# Habilita serviço de Watchdog
systemctl enable watchdog || true

# Bloqueio estrito de PulseAudio e PipeWire
systemctl mask pulseaudio.service pulseaudio.socket pipewire.service pipewire.socket 2>/dev/null || true

# Configura ALSA inicial
amixer sset Master unmute 2>/dev/null || true
amixer sset Master 100% 2>/dev/null || true
amixer sset PCM unmute 2>/dev/null || true
amixer sset PCM 100% 2>/dev/null || true
alsactl store 2>/dev/null || true

echo "--> [Hook Jukebox] Configuração concluída com sucesso."
