#!/bin/sh
##
## CAMADA 3 — live-build chroot hook (Debian 13 "Trixie")
## Purga preventiva de resíduos SysVinit + verificação do backend systemd.
##
## Momento de execução: fim do estágio chroot, APÓS os passes de instalação
## de pacotes ("install" e "live") e ANTES da montagem da imagem (binary
## stage). O bloqueio ANTES da instalação é feito pela Camada 1 (pinagem em
## config/archives/00-block-sysvinit.pref.chroot, aplicada pelo chroot_prep
## antes de qualquer apt-get) e pela Camada 2 (troca ativa nas transações).
## Este hook é a defesa final: purga qualquer resíduo que tenha escapado
## (ex.: Recommends de repositório de terceiros, chroot restaurado de cache
## antigo) e VALIDA o estado final exigido pelo kiosk — se o estado não for
## atingido, o build falha AQUI com mensagem clara, em vez de produzir uma
## ISO não-bootável.
##
## Nomenclatura: 7XXX é a faixa reservada para hooks do usuário
## (ver /usr/share/live/build/hooks/README no pacote live-build).
## Executa DENTRO do chroot (raiz do sistema que virará a ISO).
##
## ATENÇÃO: para que hooks em config/hooks/live/ sejam executados, o
## live-build exige que também exista ao menos um hook em
## config/hooks/normal/*.chroot — a árvore gerada pelo `lb config` já traz
## symlinks lá. Se você limpou esse diretório, restaure-o (veja o
## README-SYSVINIT-FIX.md, seção Troubleshooting).

set -e

HOOK_TAG="[7000-purge-sysvinit-residue]"

# Pacotes legados proibidos no kiosk (mesma lista da pinagem, Camada 1).
# NÃO incluir "sysvinit-utils" — não conflita e faz parte da base normal.
BAD_PKGS="live-config-sysvinit sysvinit-core initscripts insserv startpar sysv-rc"

# Backend systemd obrigatório: init do kiosk (autologin TTY1 + watchdog)
MUST_PKGS="systemd-sysv live-config-systemd"

log()  { echo "${HOOK_TAG} $*"; }
fail() { echo "${HOOK_TAG} ERRO: $*" >&2; exit 1; }

status_abbrev() {
	dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null || true
}

is_installed() {
	status_abbrev "$1" | grep -q '^ii'
}

# ---------------------------------------------------------------------------
# 1) Garantir o backend systemd PRIMEIRO (nunca deixe o sistema sem init)
# ---------------------------------------------------------------------------
for PKG in ${MUST_PKGS}; do
	if ! is_installed "${PKG}"; then
		log "backend obrigatório ausente — instalando: ${PKG}"
		apt-get update -qq || true
		apt-get install -y --no-install-recommends "${PKG}" \
			|| fail "não foi possível instalar ${PKG} (verifique a pinagem e os manifestos)"
	fi
done

is_installed systemd-sysv \
	|| fail "systemd-sysv não está instalado (init exigido pelo kiosk)"
is_installed live-config-systemd \
	|| fail "live-config-systemd não está instalado (backend live-config)"

# ---------------------------------------------------------------------------
# 2) Coletar e purgar resíduos SysVinit em uma única transação
# ---------------------------------------------------------------------------
RESIDUE=""
for PKG in ${BAD_PKGS}; do
	if is_installed "${PKG}"; then
		RESIDUE="${RESIDUE} ${PKG}"
	fi
done

if [ -n "${RESIDUE}" ]; then
	log "purgando resíduos SysVinit:${RESIDUE}"
	# --allow-remove-essential: sysvinit-core provê o essencial virtual "init";
	# em um chroot de build não há init em execução — a remoção é segura.
	apt-get purge -y --allow-remove-essential ${RESIDUE} \
		|| fail "falha ao purgar resíduos:${RESIDUE}"

	# Se a purga removeu pacotes que dependiam do resíduo (manifest com
	# dependência legada), avise com destaque — o manifesto precisa de ajuste.
	log "AVISO: algum pacote do seu manifest pode ter sido removido junto" \
	    "(dependia do resíduo sysvinit). Revise config/package-lists/ com" \
	    "tools/audit-sysvinit.sh e o build.log desta purga."
fi

# Limpar configurações remanescentes (estado "rc" do dpkg)
for PKG in ${BAD_PKGS}; do
	if status_abbrev "${PKG}" | grep -q '^rc'; then
		dpkg --purge "${PKG}" || true
	fi
done

# ---------------------------------------------------------------------------
# 3) Verificação final — estado exigido pelo kiosk (fail-fast)
# ---------------------------------------------------------------------------
is_installed systemd-sysv \
	|| fail "verificação final: systemd-sysv ausente"

for PKG in ${BAD_PKGS}; do
	if is_installed "${PKG}"; then
		fail "verificação final: ${PKG} ainda instalado — alguma dependência o exige; rode tools/audit-sysvinit.sh e verifique config/package-lists/"
	fi
done

if [ ! -e /sbin/init ]; then
	fail "/sbin/init não existe — a ISO não seria bootável"
fi

log "OK: init = systemd (systemd-sysv); backend live-config = live-config-systemd; nenhum resíduo SysVinit."
