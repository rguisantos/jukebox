// =============================================================================
// JUKEBOX ARCADE OS — Interface principal (Slint) — MÓDULO 7
// -----------------------------------------------------------------------------
// Layout 1024x768 para kiosk de bar — navegação 100% por controles arcade
// (controladora USB "Zero Delay" vista como teclado: E/R/I/W/Q/O/U/P/Z/X).
//
//   ┌──────────────────────────────────────────┬──────────────┐
//   │  HEADER: título + badge de créditos      │              │
//   ├──────────────────────────────────────────┤  TOCANDO     │
//   │                                          │  AGORA       │
//   │   CAMADA 1: CARROSSEL DE CAPAS (E/R/I)   ├──────────────┤
//   │   CAMADA 2: FAIXAS DO ÁLBUM (W/Q/O/U)    │  A SEGUIR    │
//   │   ou ÁREA DE VÍDEO (XVideo embutido,     │  (fila)      │
//   │    pintado pelo GStreamer nesta região)  ├──────────────┤
//   │                                          │  PAGUE COM   │
//   ├──────────────────────────────────────────┤  PIX (QR)    │
//   │  FOOTER: mapa das teclas arcade          │              │
//   └──────────────────────────────────────────┴──────────────┘
//
//   Overlays flutuantes (desenhados por cima de tudo):
//     · Barra de volume (P abre; W/Q ajusta; U fecha) — faixa do topo
//     · Menu do operador (X abre; W/Q navega; O confirma; U fecha):
//       IP da máquina, total de créditos arrecadados e sync USB forçada
//     · Sincronização USB (Módulo 4, tela cheia)
//     · Toast de notificações (PIX, erros, fila cheia...)
//
//   A máquina de estados de foco vive em Rust (state/models.rs — AppState)
//   e é espelhada aqui pela propriedade `ui-focus`:
//     0 = BrowsingAlbums · 1 = BrowsingTracks
//     2 = VolumeControl  · 3 = OperatorMenu
//   O Slint é RENDERIZADOR PURO do estado: nenhuma decisão de navegação é
//   tomada aqui — apenas camadas condicionais e feedback visual.
//
//   Animações: instantâneas por especificação (GPU GMA 3150 + Sempron 145).
// =============================================================================

import { ListView, Spinner } from "std-widgets.slint";

// Estrutura compartilhada entre Slint e Rust (catálogo e fila)
export struct TrackData {
    id: int,
    title: string,
    artist: string,
    album: string,
    file-type: string,
    // Caminho no disco — invisível na UI, usado pelo player ao tocar
    file-path: string,
}

// MÓDULO 7 — Um disco do catálogo (cartão do carrossel de capas).
// `tracks` é o modelo aninhado (Model de Músicas dentro do Model de Álbuns).
// `cover` chega depois, preenchido pela thread de capas (ID3 APIC → RGB)
// via substituição de linha do VecModel no Rust — `has-cover` acende a
// textura; antes disso o disco mostra o placeholder colorido com a inicial.
export struct AlbumData {
    key: string,
    title: string,
    artist: string,
    initial: string,
    palette: int,
    has-cover: bool,
    cover: image,
    tracks: [TrackData],
}

// =============================================================================
// Linha de faixa (56px — altura referência para a navegação por teclado)
// =============================================================================
component TrackRow inherits Rectangle {
    in property <int> index;
    in property <TrackData> track;
    in property <bool> is-selected;
    in property <bool> is-playing;
    in property <bool> has-focus-list; // painel visível (vídeo não tocando)

    // Dispara quando o operador toca/clica na linha (a MainWindow conecta)
    callback activated(int);

    height: 56px;
    background: is-selected && has-focus-list ? #1c2033 : (mod(index, 2) == 0 ? #0d0e14 : #101118);

    // Barra de acento à esquerda quando selecionada
    Rectangle {
        x: 0; y: 0;
        width: 4px; height: parent.height;
        background: is-selected && has-focus-list ? #818cf8 : transparent;
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 16px;

        // Número da faixa (ou indicador "tocando")
        Text {
            text: is-playing ? "♪" : "\{index + 1}";
            color: is-playing ? #34d399 : (is-selected && has-focus-list ? #a5b4fc : #4b5563);
            font-size: 15px;
            font-weight: 700;
            width: 40px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        // Ícone do tipo de mídia (♫ áudio / ▶ vídeo)
        Text {
            text: track.file-type == "mp3" || track.file-type == "wav" ? "♫" : "▶";
            color: track.file-type == "mp3" || track.file-type == "wav" ? #818cf8 : #34d399;
            font-size: 18px;
            width: 28px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        // Título
        Text {
            text: track.title;
            color: is-playing ? #6ee7b7 : (is-selected && has-focus-list ? #f8fafc : #e5e7eb);
            font-size: 16px;
            font-weight: is-playing || (is-selected && has-focus-list) ? 700 : 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // Artista
        Text {
            text: track.artist;
            color: #9ca3af;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            width: 200px;
            horizontal-alignment: right;
        }
    }

    // Toque/clique também seleciona e executa (telas de toque de bar)
    TouchArea {
        clicked => {
            root.activated(root.index);
        }
    }
}

// =============================================================================
// Linha compacta da fila "A seguir"
// =============================================================================
component QueueRow inherits Rectangle {
    in property <int> index;
    in property <TrackData> track;

    height: 40px;
    background: mod(index, 2) == 0 ? #0d0e14 : #101118;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        Text {
            text: "\{index + 1}";
            color: #4b5563;
            font-size: 13px;
            font-weight: 700;
            width: 22px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        Text {
            text: track.file-type == "mp3" || track.file-type == "wav" ? "♫" : "▶";
            color: track.file-type == "mp3" || track.file-type == "wav" ? #6366f1 : #10b981;
            font-size: 13px;
            width: 18px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        Text {
            text: track.title;
            color: #cbd5e1;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

// =============================================================================
// MÓDULO 7 — Cartão de disco do carrossel de capas
// =============================================================================
component AlbumCard inherits Rectangle {
    in property <int> index;
    in property <AlbumData> album;
    in property <bool> is-selected;
    callback activated(int);

    width: 176px;
    height: 232px;
    background: transparent;

    // Moldura da capa: arte embutida ou placeholder colorido com a inicial.
    // A paleta vem do hash da chave do disco (Rust) — cor estável para sempre.
    Rectangle {
        y: 0;
        width: 176px;
        height: 176px;
        border-radius: 12px;
        clip: true;
        border-width: root.is-selected ? 3px : 1px;
        border-color: root.is-selected ? #818cf8 : #1e2438;
        background: root.album.palette == 0 ? #312e81 :
                    root.album.palette == 1 ? #134e4a :
                    root.album.palette == 2 ? #7f1d1d :
                    root.album.palette == 3 ? #78350f :
                    root.album.palette == 4 ? #4c1d95 :
                                              #14532d;

        // Arte real (pixels RGB da thread de capas — sem I/O de disco)
        if root.album.has-cover : Image {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            source: root.album.cover;
            image-fit: ImageFit.cover;
        }

        // Placeholder: inicial do título do disco
        if !root.album.has-cover : Text {
            text: root.album.initial;
            color: #cbd5e1;
            font-size: 64px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Título do disco
    Text {
        y: 184px;
        x: 0;
        width: parent.width;
        text: root.album.title;
        color: root.is-selected ? #f8fafc : #cbd5e1;
        font-size: 15px;
        font-weight: root.is-selected ? 700 : 600;
        overflow: elide;
        horizontal-alignment: center;
    }

    // Artista
    Text {
        y: 206px;
        x: 0;
        width: parent.width;
        text: root.album.artist;
        color: #6b7280;
        font-size: 13px;
        overflow: elide;
        horizontal-alignment: center;
    }

    // Escurece os cartões não selecionados (troca instantânea, sem animação)
    if !root.is-selected : Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000059;
    }

    // Toque/clique na capa abre o disco (equivalente à tecla I)
    TouchArea {
        clicked => {
            root.activated(root.index);
        }
    }
}

// =============================================================================
// MÓDULO 7 — Linha do menu do operador (IP / total arrecadado / sync USB)
// =============================================================================
component OperatorMenuRow inherits Rectangle {
    in property <int> index;
    in property <int> selected-index;
    in property <string> label;
    in property <string> value;
    in property <bool> actionable; // linha executável (O confirma)

    height: 64px;
    background: root.index == root.selected-index ? #1c2033 : #101118;
    border-width: root.index == root.selected-index ? 2px : 1px;
    border-color: root.index == root.selected-index ? #f59e0b : #1e2438;
    border-radius: 10px;

    // Barra de acento à esquerda quando selecionada
    Rectangle {
        x: 0; y: 10px;
        width: 4px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: root.index == root.selected-index ? #f59e0b : transparent;
    }

    HorizontalLayout {
        padding-left: 26px;
        padding-right: 26px;
        spacing: 16px;

        Text {
            text: root.label;
            color: root.index == root.selected-index ? #f8fafc : #cbd5e1;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.value;
            color: root.actionable ? #34d399 : #fbbf24;
            font-size: 15px;
            font-weight: 800;
            vertical-alignment: center;
            overflow: elide;
            width: 240px;
            horizontal-alignment: right;
        }
    }
}

// =============================================================================
// Janela principal
// =============================================================================
export component MainWindow inherits Window {
    title: "Jukebox Arcade OS";
    background: #08080c;
    preferred-width: 1024px;
    preferred-height: 768px;

    // =========================================================================
    // Estado sincronizado com as threads de controle Rust
    // =========================================================================

    // Créditos e catálogo agrupado (Módulos 1, 2 e 7)
    in-out property <int> credits: 0;
    in-out property <bool> scanning: true;

    // MÓDULO 7 — Espelho da máquina de estados de foco (state/models.rs):
    //   0 = BrowsingAlbums · 1 = BrowsingTracks
    //   2 = VolumeControl  · 3 = OperatorMenu
    in-out property <int> ui-focus: 0;

    // Catálogo aninhado (Model de Álbuns, cada um com Model de Músicas)
    in-out property <[AlbumData]> albums: [];
    in-out property <int> selected-album: 0;

    // Álbum aberto no painel de faixas (Camada 2)
    in-out property <string> current-album-title: "";
    in-out property <string> current-album-artist: "";
    in-out property <int> current-album-count: 0;
    in-out property <[TrackData]> current-album-tracks: [];
    in-out property <int> selected-track: 0;

    // Overlay de volume (2 = VolumeControl)
    in-out property <int> volume-value: 70;

    // Menu do operador (3 = OperatorMenu)
    in-out property <int> op-menu-index: 0;
    in-out property <string> op-ip: "";
    in-out property <int> op-total-collected: 0;

    // Player e fila (Módulo 3)
    in property <bool> np-active: false;
    in property <int> np-track-id: -1;
    in property <string> np-title: "";
    in property <string> np-artist: "";
    in property <bool> np-video: false;
    in property <[TrackData]> queue-tracks: [];

    // PIX (Módulo 5)
    in property <image> pix-qr-image;
    in property <bool> pix-loading: true;
    in property <bool> pix-offline: false;
    in property <string> pix-error-text: "";

    // Toast flutuante (kind: 0=informação 1=sucesso 2=erro)
    in property <bool> toast-visible: false;
    in property <string> toast-message: "";
    in property <int> toast-kind: 0;

    // Overlay de sincronização USB (Módulo 4) — state: 1=sincronizando 2=concluído 3=falha
    in property <bool> usb-overlay-visible: false;
    in property <int> usb-state: 1;
    in property <int> usb-total: 0;
    in property <int> usb-copied: 0;
    in property <int> usb-new-tracks: 0;
    in property <string> usb-current-file: "";
    in property <string> usb-error-text: "";

    // =========================================================================
    // Callbacks -> core engine Rust
    // =========================================================================
    // Único ponto de entrada do teclado: a máquina de estados em Rust decide
    // o que fazer com cada tecla (case-insensitive) e devolve true quando
    // o evento foi consumido. Setas/Enter/Esc chegam aqui como aliases
    // (manutenção com teclado comum — o público do bar usa só o arcade).
    callback arcade-key-pressed(string) -> bool;
    // Clique/toque numa capa do carrossel (equivale à tecla I)
    callback album-activated(int);
    // Clique/toque numa faixa do álbum aberto (equivale à tecla O)
    callback track-activated(int);
    callback pix-retry();                                    // botão tentar novamente
    callback usb-close();                                    // fechar overlay USB
    callback video-geometry-changed(length, length, length, length); // x,y,w,h da área de vídeo

    // Direciona o foco do teclado para o handler global
    forward-focus: keyboard-handler;

    keyboard-handler := FocusScope {
        key-pressed(event) => {
            // ---- Aliases de manutenção (teclado USB comum) ----
            if (event.text == Key.LeftArrow) {
                if (root.arcade-key-pressed("e")) { return accept; }
                return reject;
            }
            if (event.text == Key.RightArrow) {
                if (root.arcade-key-pressed("r")) { return accept; }
                return reject;
            }
            if (event.text == Key.UpArrow) {
                if (root.arcade-key-pressed("w")) { return accept; }
                return reject;
            }
            if (event.text == Key.DownArrow) {
                if (root.arcade-key-pressed("q")) { return accept; }
                return reject;
            }
            if (event.text == Key.Escape) {
                if (root.arcade-key-pressed("u")) { return accept; }
                return reject;
            }
            if (event.text == Key.Return) {
                // No carrossel, Enter abre o disco (I); no painel de faixas
                // e no menu do operador, confirma (O)
                if (root.ui-focus == 0) {
                    if (root.arcade-key-pressed("i")) { return accept; }
                } else {
                    if (root.arcade-key-pressed("o")) { return accept; }
                }
                return reject;
            }

            // ---- Teclas da controladora arcade (Zero Delay) ----
            // E/R/I/W/Q/O/U/P/Z/X chegam como texto comum, maiúsculo ou
            // minúsculo — o Rust normaliza antes de despachar.
            if (root.arcade-key-pressed(event.text)) {
                return accept;
            }
            return reject;
        }
    }

    // =========================================================================
    // Layout principal
    // =========================================================================
    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ------------------------------------------------------------------
        // Barra superior: título + badge de créditos
        // ------------------------------------------------------------------
        Rectangle {
            height: 80px;
            background: #0a0b10;

            Text {
                x: 32px;
                text: "JUKEBOX ARCADE OS";
                color: #e5e7eb;
                font-size: 22px;
                font-weight: 800;
                vertical-alignment: center;
            }

            Rectangle {
                x: parent.width - self.width - 28px;
                y: (parent.height - self.height) / 2;
                width: 200px;
                height: 48px;
                background: #12131c;
                border-radius: 10px;
                border-width: 2px;
                border-color: #f59e0b;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: center;
                    spacing: 10px;

                    Text {
                        text: "CRÉDITOS:";
                        color: #9ca3af;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "\{root.credits}";
                        color: #fbbf24;
                        font-size: 22px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { height: 2px; background: #1e1f2e; }

        // ------------------------------------------------------------------
        // Corpo: navegação/vídeo (esquerda) + painel lateral (direita)
        // ------------------------------------------------------------------
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;
            vertical-stretch: 1;

            // ============================ ESQUERDA =========================
            Rectangle {
                horizontal-stretch: 1;

                // CAMADA DE FUNDO: área de vídeo — sempre presente para
                // reportar geometria ao GStreamer (GstVideoOverlay). O vídeo
                // é composto pelo X11 ACIMA de qualquer desenho do Slint.
                video-area := Rectangle {
                    background: #000000;

                    // Espelha o estado do player nesta propriedade local
                    // para disparar o callback de geometria também quando
                    // a área de vídeo acaba de surgir
                    property <bool> video-active: root.np-video;
                    changed video-active => {
                        if (self.video-active) {
                            root.video-geometry-changed(self.x, self.y, self.width, self.height);
                        }
                    }
                    changed x => {
                        root.video-geometry-changed(self.x, self.y, self.width, self.height);
                    }
                    changed y => {
                        root.video-geometry-changed(self.x, self.y, self.width, self.height);
                    }
                    changed width => {
                        root.video-geometry-changed(self.x, self.y, self.width, self.height);
                    }
                    changed height => {
                        root.video-geometry-changed(self.x, self.y, self.width, self.height);
                    }

                    // Durante o vídeo: mensagem discreta (o XVideo pinta aqui)
                    Text {
                        text: "▶  REPRODUZINDO VÍDEO";
                        color: #334155;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // =============================================================
                // CAMADA 1 (ui-focus 0): carrossel de capas de disco
                // =============================================================
                if !root.np-video && root.ui-focus != 1 && !root.scanning && root.albums.length > 0 : Rectangle {
                    VerticalLayout {
                        padding: 0px;
                        spacing: 0px;

                        // Cabeçalho do carrossel
                        Rectangle {
                            height: 52px;
                            background: #0c0d13;

                            HorizontalLayout {
                                padding-left: 32px;
                                padding-right: 32px;
                                alignment: space-between;

                                Text {
                                    text: "DISCOS  ·  \{root.albums.length}";
                                    color: #818cf8;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "E e R navegam   ·   I abre o disco";
                                    color: #6b7280;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1b26; }

                        // Faixa das capas: rolagem horizontal INSTANTÂNEA por
                        // expressão (offset é função pura do disco selecionado
                        // — zero animação, zero Flickable, zero custo de GPU)
                        carousel := Rectangle {
                            vertical-stretch: 1;
                            clip: true;
                            background: #08080c;

                            property <length> pitch: 204px;   // largura + espaçamento
                            property <length> card-w: 176px;
                            property <length> content-w: max(root.albums.length * self.pitch, self.width);
                            // Centraliza o disco selecionado (clamp nas bordas)
                            property <length> raw-off: root.selected-album * self.pitch
                                - (self.width - self.card-w) / 2;
                            property <length> off: min(max(0px, self.raw-off), self.content-w - self.width);

                            for album[index] in root.albums : AlbumCard {
                                x: index * carousel.pitch - carousel.off;
                                y: (carousel.height - self.height) / 2;
                                index: index;
                                album: album;
                                is-selected: index == root.selected-album;
                                activated(i) => {
                                    root.album-activated(i);
                                }
                            }
                        }

                        // Painel de informações do disco selecionado
                        Rectangle {
                            height: 168px;
                            background: #0c0d13;

                            Rectangle {
                                y: 0;
                                width: parent.width;
                                height: 1px;
                                background: #1a1b26;
                            }

                            VerticalLayout {
                                padding: 20px;
                                spacing: 6px;

                                Text {
                                    text: root.current-album-title != ""
                                        ? root.current-album-title
                                        : "Selecione um disco";
                                    color: root.current-album-title != "" ? #f8fafc : #475569;
                                    font-size: 24px;
                                    font-weight: 800;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.current-album-artist != ""
                                        ? root.current-album-artist
                                        : "Navegue com E e R";
                                    color: #94a3b8;
                                    font-size: 15px;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    spacing: 16px;
                                    alignment: start;

                                    // Chamada de ação (a tecla I abre as faixas;
                                    // toque/clique também funciona)
                                    Rectangle {
                                        width: 300px;
                                        height: 44px;
                                        background: cta-touch.has-hover ? #4f46e5 : #6366f1;
                                        border-radius: 10px;

                                        cta-touch := TouchArea {
                                            clicked => {
                                                root.album-activated(root.selected-album);
                                            }
                                        }

                                        Text {
                                            text: "APERTE I PARA VER AS MÚSICAS";
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: "\{root.current-album-count} faixas";
                                        color: #64748b;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // =============================================================
                // CAMADA 2 (ui-focus 1): faixas do álbum aberto
                // =============================================================
                if !root.np-video && root.ui-focus == 1 && !root.scanning : Rectangle {
                    VerticalLayout {
                        padding: 0px;
                        spacing: 0px;

                        // Cabeçalho do álbum aberto
                        Rectangle {
                            height: 52px;
                            background: #0c0d13;

                            HorizontalLayout {
                                padding-left: 32px;
                                padding-right: 32px;
                                spacing: 24px;

                                Text {
                                    text: "◀ U VOLTAR";
                                    color: #818cf8;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.current-album-title;
                                    color: #f8fafc;
                                    font-size: 16px;
                                    font-weight: 800;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "\{root.current-album-count} faixas";
                                    color: #6b7280;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1b26; }

                        // Lista virtualizada de faixas do disco
                        if root.current-album-tracks.length > 0 : Rectangle {
                            vertical-stretch: 1;
                            background: #08080c;

                            tracks-list := ListView {
                                for track[index] in root.current-album-tracks : TrackRow {
                                    index: index;
                                    track: track;
                                    is-selected: index == root.selected-track;
                                    is-playing: track.id == root.np-track-id;
                                    has-focus-list: root.ui-focus == 1 && !root.np-video;
                                    activated(i) => {
                                        root.track-activated(i);
                                    }
                                }

                                // Espelha a seleção para reagir a mudanças dela
                                property <int> sel: root.selected-track;

                                // Mantém a linha selecionada visível ao navegar
                                changed sel => {
                                    if (self.sel * 56px < -self.viewport-y) {
                                        self.viewport-y = 0px - self.sel * 56px;
                                    } else if ((self.sel + 1) * 56px > -self.viewport-y + self.height) {
                                        self.viewport-y = self.height - (self.sel + 1) * 56px;
                                    }
                                }
                            }
                        }
                    }
                }

                // Estado vazio (catálogo sem faixas e sem escaneamento)
                if !root.np-video && root.albums.length == 0 && !root.scanning : Rectangle {
                    VerticalLayout {
                        alignment: center;
                        spacing: 12px;

                        Text {
                            text: "Nenhuma música encontrada";
                            color: #6b7280;
                            font-size: 20px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Insira um pendrive para sincronizar";
                            color: #4b5563;
                            font-size: 15px;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Estado de escaneamento inicial
                if !root.np-video && root.scanning : Rectangle {
                    VerticalLayout {
                        alignment: center;
                        spacing: 16px;

                        Text {
                            text: "♫";
                            color: #818cf8;
                            font-size: 48px;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Carregando catálogo...";
                            color: #9ca3af;
                            font-size: 18px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            Rectangle { width: 2px; background: #1e1f2e; }

            // ============================ DIREITA ==========================
            Rectangle {
                width: 310px;
                background: #0a0b10;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // ---- TOCANDO AGORA -------------------------------------
                    Rectangle {
                        height: 116px;
                        background: #12131c;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #1e2438;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;

                            Text {
                                text: "♪ TOCANDO AGORA";
                                color: #34d399;
                                font-size: 12px;
                                font-weight: 800;
                            }

                            Text {
                                text: root.np-active ? root.np-title : "—";
                                color: root.np-active ? #f8fafc : #475569;
                                font-size: 16px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            Text {
                                text: root.np-active ? root.np-artist : "Fila vazia";
                                color: root.np-active ? #94a3b8 : #475569;
                                font-size: 13px;
                                overflow: elide;
                            }

                            Text {
                                text: root.np-video ? "▶ VÍDEO" : "♫ ÁUDIO";
                                color: root.np-video ? #34d399 : #64748b;
                                font-size: 11px;
                                font-weight: 700;
                            }
                        }
                    }

                    // ---- FILA: A SEGUIR ------------------------------------
                    Rectangle {
                        vertical-stretch: 1;
                        background: #0d0e14;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #1e2438;
                        clip: true;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "A SEGUIR  ·  \{root.queue-tracks.length}";
                                color: #818cf8;
                                font-size: 12px;
                                font-weight: 800;
                            }

                            if root.queue-tracks.length == 0 : Text {
                                text: "Escolha um disco (tecla I) e\naperte O numa música";
                                color: #475569;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            if root.queue-tracks.length > 0 : ListView {
                                for track[index] in root.queue-tracks : QueueRow {
                                    index: index;
                                    track: track;
                                }
                            }
                        }
                    }

                    // ---- PAINEL PIX ----------------------------------------
                    Rectangle {
                        height: 346px;
                        background: #0d1117;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #164e63;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: "PAGUE COM PIX";
                                color: #2dd4bf;
                                font-size: 14px;
                                font-weight: 800;
                                horizontal-alignment: center;
                            }

                            // Moldura do QR (fundo branco p/ contraste máximo)
                            Rectangle {
                                width: 248px;
                                height: 248px;
                                background: #ffffff;
                                border-radius: 8px;

                                // Estado: QR pronto
                                if !root.pix-loading && !root.pix-offline : Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 232px;
                                    height: 232px;
                                    source: root.pix-qr-image;
                                    image-fit: ImageFit.contain;
                                }

                                // Estado: gerando QR (spinner nativo animado)
                                if root.pix-loading : Rectangle {
                                    x: 0; y: 0;
                                    width: parent.width;
                                    height: parent.height;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 10px;

                                        Spinner {
                                            width: 42px;
                                            height: 42px;
                                        }

                                        Text {
                                            text: "GERANDO\nQR CODE...";
                                            color: #0f766e;
                                            font-size: 14px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }

                                // Estado: sem conexão + botão de retry
                                if root.pix-offline && !root.pix-loading : Rectangle {
                                    x: 0; y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    background: #f8fafc;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;

                                        Text {
                                            text: "SEM CONEXÃO";
                                            color: #b91c1c;
                                            font-size: 15px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                        }

                                        Text {
                                            text: root.pix-error-text == ""
                                                ? "Verifique a internet"
                                                : root.pix-error-text;
                                            color: #64748b;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                            width: 220px;
                                        }

                                        retry-button := Rectangle {
                                            width: 150px;
                                            height: 34px;
                                            background: retry-mouse.has-hover ? #0d9488 : #14b8a6;
                                            border-radius: 8px;

                                            retry-mouse := TouchArea {
                                                clicked => { root.pix-retry(); }
                                            }

                                            Text {
                                                text: "TENTAR NOVAMENTE";
                                                color: #ffffff;
                                                font-size: 11px;
                                                font-weight: 800;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "R$ 2,00 = 1 CRÉDITO";
                                color: #fbbf24;
                                font-size: 15px;
                                font-weight: 800;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Aponte a câmera do app\ndo seu banco para o código";
                                color: #64748b;
                                font-size: 11px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------------
        // Rodapé: mapa das teclas do gabinete arcade
        // ------------------------------------------------------------------
        Rectangle {
            height: 44px;
            background: #0a0b10;

            Text {
                text: "E·R capas   ·   I abre   ·   W·Q lista   ·   O toca   ·   U volta   ·   P volume   ·   Z crédito   ·   X operador";
                color: #4b5563;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    // =========================================================================
    // OVERLAY: Toast flutuante (notificações PIX, erros, fila cheia...)
    // Ancorado na COLUNA DIREITA (sobre TOCANDO AGORA / fila): o vídeo XVideo
    // pinta acima do desenho do Slint na zona esquerda — aqui o toast nunca
    // fica escondido atrás do vídeo durante uma reprodução.
    // =========================================================================
    if root.toast-visible : Rectangle {
        x: root.width - 310px + (310px - self.width) / 2;
        y: 100px;
        height: 56px;
        width: min(toast-text.preferred-width + 56px, 294px);
        border-radius: 14px;
        background: root.toast-kind == 1 ? #065f46 : (root.toast-kind == 2 ? #7f1d1d : #312e81);
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 3px;

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            alignment: center;

            toast-text := Text {
                text: root.toast-message;
                color: #f8fafc;
                font-size: 16px;
                font-weight: 800;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }

    // =========================================================================
    // MÓDULO 7 — OVERLAY: barra de volume (ui-focus 2)
    // Faixa do TOPO da janela (sobre o header): fora do retângulo do vídeo
    // XVideo (que começa abaixo do header) — dispensa HideVideo/RestoreVideo
    // e o vídeo não "pisca" durante o ajuste.
    // =========================================================================
    if root.ui-focus == 2 : Rectangle {
        x: (root.width - self.width) / 2;
        y: 16px;
        width: 460px;
        height: 48px;
        background: #0f172af2;
        border-radius: 12px;
        border-width: 2px;
        border-color: #818cf8;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 14px;
            alignment: center;

            Text {
                text: "♪";
                color: #818cf8;
                font-size: 18px;
                vertical-alignment: center;
            }

            Text {
                text: "VOLUME";
                color: #cbd5e1;
                font-size: 13px;
                font-weight: 800;
                vertical-alignment: center;
            }

            // Trilha da barra
            Rectangle {
                height: 10px;
                width: 210px;
                background: #1e293b;
                border-radius: 5px;

                Rectangle {
                    x: 0; y: 0;
                    height: parent.height;
                    width: parent.width * root.volume-value / 100;
                    background: #6366f1;
                    border-radius: 5px;
                }
            }

            Text {
                text: "\{root.volume-value}%";
                color: #fbbf24;
                font-size: 15px;
                font-weight: 800;
                vertical-alignment: center;
                width: 52px;
            }
        }
    }

    // =========================================================================
    // MÓDULO 7 — OVERLAY: menu do operador (ui-focus 3)
    // X abre · W/Q navegam · O confirma · U fecha.
    // Mostra: IP da máquina, total de créditos arrecadados (banco) e a ação
    // "Forçar Sincronização USB". O diálogo cobre a área do vídeo XVideo —
    // o Rust envia HideVideo ao abrir e RestoreVideo ao fechar.
    // =========================================================================
    if root.ui-focus == 3 : Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: #000000e6;

        // Bloqueia cliques-toque por baixo do escurecimento
        TouchArea { }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 620px;
            height: 440px;
            background: #0d0e14;
            border-radius: 16px;
            border-width: 2px;
            border-color: #f59e0b;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000a0;

            VerticalLayout {
                padding: 32px;
                spacing: 14px;

                Text {
                    text: "MENU DO OPERADOR";
                    color: #f59e0b;
                    font-size: 22px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }

                Rectangle { height: 1px; background: #1e2438; }

                OperatorMenuRow {
                    index: 0;
                    selected-index: root.op-menu-index;
                    label: "IP DA MÁQUINA";
                    value: root.op-ip != "" ? root.op-ip : "consultando...";
                    actionable: false;
                }

                OperatorMenuRow {
                    index: 1;
                    selected-index: root.op-menu-index;
                    label: "TOTAL ARRECADADO";
                    value: "\{root.op-total-collected} créditos";
                    actionable: false;
                }

                OperatorMenuRow {
                    index: 2;
                    selected-index: root.op-menu-index;
                    label: "⇅  FORÇAR SINCRONIZAÇÃO USB";
                    value: "iniciar agora";
                    actionable: true;
                }

                Rectangle { height: 1px; background: #1e2438; }

                Text {
                    text: "W/Q seleciona   ·   O confirma   ·   U fecha";
                    color: #64748b;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // =========================================================================
    // OVERLAY: Sincronização USB (tela cheia — Módulo 4)
    // =========================================================================
    if root.usb-overlay-visible : Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: #000000e6;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            height: 400px;
            background: #0d0e14;
            border-radius: 16px;
            border-width: 2px;
            border-color: root.usb-state == 3 ? #ef4444 : #818cf8;

            VerticalLayout {
                padding: 32px;
                spacing: 18px;
                alignment: start;

                // ---- Estado 1: sincronizando ----
                if root.usb-state == 1 : VerticalLayout {
                    spacing: 14px;
                    alignment: start;

                    Text {
                        text: "⇅  SINCRONIZANDO MÍDIA";
                        color: #818cf8;
                        font-size: 22px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "\{root.usb-copied} de \{root.usb-total} arquivos";
                        color: #e5e7eb;
                        font-size: 16px;
                        horizontal-alignment: center;
                    }

                    // Barra de progresso
                    Rectangle {
                        height: 18px;
                        border-radius: 9px;
                        background: #1e293b;

                        Rectangle {
                            x: 3px;
                            y: 3px;
                            height: 12px;
                            width: max(12px, (parent.width - 6px)
                                * (root.usb-copied * 100 / max(1, root.usb-total)) / 100);
                            border-radius: 6px;
                            background: #6366f1;
                        }
                    }

                    Text {
                        text: root.usb-current-file;
                        color: #64748b;
                        font-size: 12px;
                        horizontal-alignment: center;
                        overflow: elide;
                        width: parent.width - 32px;
                    }

                    Text {
                        text: "NÃO REMOVA O PENDRIVE";
                        color: #fbbf24;
                        font-size: 14px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }
                }

                // ---- Estado 2: concluído ----
                if root.usb-state == 2 : VerticalLayout {
                    spacing: 14px;
                    alignment: start;

                    Text {
                        text: "✓  SINCRONIZAÇÃO CONCLUÍDA";
                        color: #34d399;
                        font-size: 22px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "\{root.usb-copied} arquivos sincronizados";
                        color: #e5e7eb;
                        font-size: 16px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "\{root.usb-new-tracks} faixas no catálogo";
                        color: #94a3b8;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }

                    ok-button := Rectangle {
                        width: 180px;
                        height: 44px;
                        background: ok-mouse.has-hover ? #059669 : #10b981;
                        border-radius: 10px;

                        ok-mouse := TouchArea {
                            clicked => { root.usb-close(); }
                        }

                        Text {
                            text: "CONCLUIR";
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // ---- Estado 3: falha ----
                if root.usb-state == 3 : VerticalLayout {
                    spacing: 14px;
                    alignment: start;

                    Text {
                        text: "✕  FALHA NA SINCRONIZAÇÃO";
                        color: #f87171;
                        font-size: 22px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.usb-error-text == ""
                            ? "Erro de leitura ou escrita no disco"
                            : root.usb-error-text;
                        color: #94a3b8;
                        font-size: 13px;
                        horizontal-alignment: center;
                        overflow: elide;
                        width: parent.width - 32px;
                    }

                    close-button := Rectangle {
                        width: 180px;
                        height: 44px;
                        background: close-mouse.has-hover ? #b91c1c : #ef4444;
                        border-radius: 10px;

                        close-mouse := TouchArea {
                            clicked => { root.usb-close(); }
                        }

                        Text {
                            text: "FECHAR";
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}


